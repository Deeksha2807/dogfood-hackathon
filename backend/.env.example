# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local machine development connection:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/dogfood_hackathon?schema=public
# Docker Compose backend container connection (uncomment when running backend inside Compose network):
# DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/dogfood_hackathon?schema=public

# PostgreSQL Service Credentials (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=dogfood_hackathon
POSTGRES_PORT=5432

# Client & Security Configuration
CLIENT_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=session_token
SESSION_MAX_AGE_MS=604800000
